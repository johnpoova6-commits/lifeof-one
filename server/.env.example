PORT=5000
# Local development only. In production, set this to a hosted MongoDB URI in the deployment environment.
MONGODB_URI=mongodb://127.0.0.1:27017/lifeof-hub
JWT_SECRET=replace-this-with-a-long-random-secret
# Must be the same Web application OAuth client ID as client/.env.
GOOGLE_CLIENT_ID=
MAX_UPLOAD_SIZE_MB=100
# SMTP settings are required for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CLIENT_URL=http://localhost:5173
